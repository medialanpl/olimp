# Copy to .env (kept out of git): `pnpm start`, `pnpm mcp` and `pnpm agent-login` read it when it
# exists.
# Every variable is optional; the comment gives its default.

# Database. Without it OLIMP uses SQLite in OLIMP_HOME. The URL below matches compose.yaml
# (`docker compose up -d`); OLIMP creates a missing database when the user may. The password stays
# here or in the environment, never in the repository, and OLIMP never logs it.
# MariaDB works the same. Over a network add ?ssl-mode=REQUIRED (encrypted, a self-signed
# certificate as on shared hosting) or ?ssl-mode=VERIFY_IDENTITY (certificate and host checked).
# OLIMP_DATABASE_URL=mysql://olimp:olimp@127.0.0.1:3306/olimp

# Tests on MySQL (`pnpm test:mysql`). Without a database in the URL (compose.yaml's root) every test
# gets its own database; with one (a hosting account) all tests share it and drop its tables, so it
# must hold nothing else.
# OLIMP_TEST_MYSQL_URL=mysql://root:olimp-root@127.0.0.1:3306
# OLIMP_TEST_MYSQL_URL=mysql://user:password@db.example.com:3306/olimp_test?ssl-mode=REQUIRED

# Database (SQLite), clones of task and skills repositories, worktrees, and the agent logins of
# accounts (users/<id>/home). Default: ~/.olimp
# OLIMP_HOME=/home/me/.olimp

# Folders of cloned and new repositories, and where the folder picker starts (nothing above it can
# be listed or registered). Defaults: $OLIMP_HOME/projects and your home folder
# OLIMP_PROJECTS=/home/me/olimp/projects
# OLIMP_BROWSE_ROOT=/home/me

# API port, bound to 127.0.0.1. Default: 4850
# OLIMP_PORT=4850

# Host name of a TLS proxy (Caddy, nginx) in front of the API. Accepted only while accounts exist;
# OLIMP refuses to start with it and no account. Default: none
# OLIMP_PUBLIC_HOST=olimp.example.com

# Binaries of the agents and of GitHub's CLI, a name on PATH or an absolute path.
# OLIMP_CLAUDE=claude
# OLIMP_CODEX=codex
# OLIMP_GH=gh

# Agent time limit in minutes per task and per agent step of a workflow. Default: 30
# OLIMP_TASK_TIMEOUT_MIN=30

# How many tasks and workflow runs work at once; a folder without git takes one at a time. Default: 1
# OLIMP_MAX_PARALLEL=1

# These two, OLIMP_PROJECTS and OLIMP_BROWSE_ROOT are defaults: a value saved in the panel's
# settings (or through the API or MCP) wins until it is reset there.

# Agents get only system variables, their own login variables and those of the step's
# integrations; list more names here to pass them to every agent (never OLIMP_*). Default: none
# OLIMP_AGENT_ENV=XDG_CONFIG_HOME,NODE_EXTRA_CA_CERTS

# MCP server: the API it calls and the language of API messages it asks for (en or pl).
# OLIMP_URL=http://127.0.0.1:4850
# OLIMP_LOCALE=en

# Your account's token, sent by the MCP server and `pnpm agent-login` once accounts exist. Keep it
# like a password; it never reaches an agent.
# OLIMP_TOKEN=olimp_…

# E-mail, as in Corivo: invitations, password resets and the sign-in codes of accounts without an
# authenticator app. A server saved in Settings, Mail replaces these two. Without any, accounts
# must use an app, and invitations cannot be sent.
# OLIMP_SMTP_URL=smtps://user:password@smtp.example.com:465
# OLIMP_MAIL_FROM=OLIMP <noreply@example.com>
