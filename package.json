{
    "name": "olimp",
    "version": "0.1.0",
    "private": true,
    "bin": {
        "olimp": "src/cli.ts"
    },
    "description": "Self-hosted platform for AI coding agents working on your Git repositories.",
    "license": "MIT",
    "keywords": [
        "ai-agents",
        "coding-agents",
        "claude-code",
        "codex",
        "opencode",
        "github-copilot",
        "agent-orchestration",
        "self-hosted",
        "git-worktrees",
        "pull-requests",
        "workflow-automation",
        "mcp"
    ],
    "type": "module",
    "packageManager": "pnpm@12.4.2",
    "engines": {
        "node": ">=24.2"
    },
    "scripts": {
        "start": "node --env-file-if-exists=.env src/main.ts",
        "olimp": "node src/cli.ts",
        "dev": "node scripts/dev.ts",
        "build": "vite build web",
        "prod": "pnpm build && pnpm start",
        "dev:web": "vite web",
        "mcp": "node --env-file-if-exists=.env src/mcp.ts",
        "agent-login": "node --env-file-if-exists=.env src/agent-login.ts",
        "typecheck": "tsc --noEmit && tsc --noEmit -p web",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "check": "pnpm typecheck && pnpm lint && pnpm run test && pnpm build",
        "test": "node --test",
        "test:mysql": "node --env-file-if-exists=.env --test --test-concurrency=1",
        "upgrade:package": "pnpm update --interactive --latest",
        "package": "node scripts/package.ts"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "mysql2": "^3.24.6",
        "nodemailer": "^10.2.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "3d-force-graph": "1.80.1",
        "@biomejs/biome": "2.5.15",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@fontsource-variable/inter": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5.105.0",
        "@tanstack/react-table": "^9.3.1",
        "@types/node": "^24.19.2",
        "@types/nodemailer": "^8.0.2",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.2.0",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "class-variance-authority": "^0.7.1",
        "cmdk": "^1.1.1",
        "lucide-react": "^1.62.0",
        "qrcode": "^1.5.4",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^7.18.4",
        "shiki": "^4.5.0",
        "streamdown": "^2.7.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2",
        "use-intl": "^4.14.9",
        "vite": "^7.3.7",
        "yaml": "^2.9.1"
    },
    "optionalDependencies": {
        "@lydell/node-pty": "1.2.0-beta.18"
    }
}
